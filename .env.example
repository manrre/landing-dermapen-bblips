NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_VERSION=v21.0

# Geo Pricing
# -----------
# El sistema de precios por pais usa geolocalizacion IP gratuita.
# No requiere API key. Los proveedores usados son:
# - ip-api.com (plan gratuito, 45 req/min)
# - ipapi.co   (fallback gratuito, 1000 req/dia)
#
# La IP del visitante se extrae de los headers en este orden:
# 1. x-forwarded-for
# 2. x-real-ip
# 3. x-vercel-ip-country (Vercel)
# 4. x-azure-clientip (Azure)
# 5. req.ip (Next.js)
#
# IPs locales (127.0.0.1, ::1) usan Colombia (CO) como default.
# Si la geolocalizacion falla, se usa DEFAULT (10 USD).
